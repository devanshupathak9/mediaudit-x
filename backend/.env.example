# --- Elasticsearch: pick ONE of these ---
# 1) Elastic Cloud Serverless (or any cluster with an endpoint URL + API key):
#    ELASTIC_URL=https://my-project.es.us-east-1.aws.elastic.cloud:443
#    ELASTIC_API_KEY=...
# 2) Classic Elastic Cloud deployment. The Cloud ID looks like
#    "name:dXMtZWFzdC0x..." (not a URL):
#    ELASTIC_CLOUD_ID=...
#    ELASTIC_API_KEY=...
# 3) Local / self-managed. From Docker, a cluster on your own machine is
#    host.docker.internal, not localhost:
#    ELASTIC_URL=http://host.docker.internal:9200
#    ELASTIC_USERNAME=elastic   (optional)
#    ELASTIC_PASSWORD=          (optional)
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=

# --- Elastic Agent Builder (claim chat, app/setup_agent_builder.py) ---
# Your project's Kibana URL (not the Elasticsearch endpoint above).
# Reuses ELASTIC_API_KEY for auth -- Kibana accepts the same key. Only
# takes effect if Agent Builder is enabled on your project; verify in
# Kibana first (Agent Builder is a distinct feature from Elasticsearch
# itself, gated per-project). If unset, or if a converse call errors,
# claim chat automatically falls back to the direct Bedrock/Anthropic
# tool loop in app/agent/chat.py -- no manual switch needed.
KIBANA_URL=
CHAT_PROVIDER=agent_builder

# --- LLM for the agent orchestrator ---
# "bedrock" (default -- uses AWS, a hackathon sponsor) or "anthropic"
# (direct Anthropic API, e.g. local dev fallback).
LLM_PROVIDER=bedrock

# AWS Bedrock. Leave the two key fields blank to use boto3's normal
# credential chain instead (env vars already exported in your shell,
# `aws configure`'s ~/.aws/credentials, an IAM role, SSO login, etc.) --
# only fill these in if you want the .env file itself to carry the
# credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Bedrock model ID (or cross-region inference profile ID). VERIFY this
# against your own AWS account before the event: Bedrock requires
# explicit per-model access approval (Console -> Bedrock -> Model access)
# and the exact ID string can vary by region/account -- check
# Console -> Bedrock -> Model catalog if the default below 404s on you.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ADDED (18 Sept): AWS's newer Bedrock API key (a single bearer-token
# credential, ABSK-prefixed, ~132 chars -- Console -> Bedrock -> API
# keys). If set, this takes priority over AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN above -- don't set both styles
# at once. Requires anthropic>=0.88.0 (see requirements.txt).
AWS_BEARER_TOKEN_BEDROCK=

# Direct Anthropic API -- only read if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OCR (document text extraction) ---
# "tesseract" (local, free -- requires the tesseract-ocr binary installed
# separately, it is not a pip package) or "none" (scanned pages/images come
# back ocr_status=FAILED instead of guessed text).
OCR_PROVIDER=tesseract

# Only needed if the tesseract binary isn't on PATH, e.g. on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# App
APP_ENV=development

# Browser origins allowed to call the API (CORS), comma-separated, e.g.
# CORS_ORIGINS=http://localhost:3000,http://187.77.130.9:3000
# ("*" allows any origin; fine for testing, not for production.)
CORS_ORIGINS=http://localhost:3000

# --- Document ingestion (app/pipeline/ingestion) ---
# UPLOAD_DIR defaults to backend/uploads when unset.
# UPLOAD_DIR=
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=20
MAX_PDF_PAGES=200
MIN_IMAGE_SIDE_PX=300

# Docker only: load sample data when insurance-claims is empty (default
# true). Set to false to never write sample data to your cluster.
# SEED_SAMPLE_DATA=true

# --- Logging/monitoring (app/observability, see MONITORING.md) ---
# Threshold for the app's own loggers (logging.getLogger("app.*"));
# uvicorn/elasticsearch-py/boto3's own loggers are unaffected.
LOG_LEVEL=INFO

# Ships every log record to the app-logs index (Kibana-queryable) in
# addition to stdout. Set to false for local dev if you don't want
# per-request docs landing on a shared cluster.
LOG_TO_ELASTICSEARCH=true
