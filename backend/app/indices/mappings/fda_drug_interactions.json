      "drug_b_rxnorm":     { "type": "keyword" },
      "drug_b_name":       { "type": "text", "analyzer": "rxnorm_analyzer" },
      "drug_b_synonyms":   { "type": "text", "analyzer": "rxnorm_analyzer" },
